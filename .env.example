# PrintOps 环境变量参考 — 本文件不含真实凭据。
# 项目不会自动加载 .env；按需把所需行复制到你的 shell（export 或 PowerShell $env:）使用。
# 真实的模型 Key 只应放在 data/llm_config.json（已被 .gitignore 排除，写入时权限 0600）。

# 存储后端：sqlite（默认）| memory | custom registry
#PRINTOPS_STORE=sqlite
# 会话数据库路径（默认 data/agent.sqlite3）
#PRINTOPS_MEMORY_PATH=data/agent.sqlite3
# 监听端口（默认 4174）
#PRINTOPS_PORT=4174
# 日志级别：INFO | DEBUG 等
#PRINTOPS_LOG_LEVEL=INFO

# 模型接入（可选）— 也可在页面“模型设置”保存，写入 data/llm_config.json
#PRINTOPS_LLM_URL=
#PRINTOPS_LLM_MODEL=
#PRINTOPS_LLM_KEY=

# 单次模型规划预算（默认 20 秒，5-120 封顶）。调高时必须同步调高 PRINTOPS_REQUEST_TIMEOUT，
# 因为规划预算取两者较小值；设置页能力探测的单跳上限固定为 15 秒。
#PRINTOPS_LLM_TIMEOUT=20
# HTTP 请求总预算秒数（默认 30；非正数沿用兼容的禁用行为，不建议生产关闭）
#PRINTOPS_REQUEST_TIMEOUT=30
# 模型测试"不可达"结论的复用秒数（默认 15，0 表示每次重测；缓存键不含 API Key）
#PRINTOPS_MODEL_TEST_FAILURE_CACHE_SECONDS=15

# 运行时容量与可观测性
# 并发连接上限（默认 64，超出返回 503）
#PRINTOPS_MAX_CONNECTIONS=64
# 慢请求告警阈值毫秒（默认 1000，0 关闭）
#PRINTOPS_SLOW_REQUEST_MS=1000
# 优雅退出等待秒数（默认 5）
#PRINTOPS_SHUTDOWN_GRACE_SECONDS=5

# 仅当调试私网模型网关时才设置（放宽 SSRF 守卫，慎用）
#PRINTOPS_ALLOW_PRIVATE_LLM_HOSTS=

# MCP stdio 会话绑定与能力级
#PRINTOPS_MCP_SESSION_ID=
#PRINTOPS_MCP_CAPABILITIES=L0
