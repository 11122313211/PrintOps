# PrintOps 环境变量参考 — 本文件不含真实凭据。
# 项目不会自动加载 .env；按需把所需行复制到你的 shell（export 或 PowerShell $env:）使用。
# 真实的模型 Key 只应放在 data/llm_config.json（已被 .gitignore 排除，写入时权限 0600）。

# 存储后端：sqlite（默认）| memory | custom registry
#PRINTOPS_STORE=sqlite
# 会话数据库路径（默认 data/agent.sqlite3）
#PRINTOPS_MEMORY_PATH=data/agent.sqlite3
# 监听端口（默认 4174）
#PRINTOPS_PORT=4174
# 日志级别：INFO | DEBUG 等
#PRINTOPS_LOG_LEVEL=INFO

# 模型接入（可选）— 也可在页面“模型设置”保存，写入 data/llm_config.json
#PRINTOPS_LLM_URL=
#PRINTOPS_LLM_MODEL=
#PRINTOPS_LLM_KEY=

# 仅当调试私网模型网关时才设置（放宽 SSRF 守卫，慎用）
#PRINTOPS_ALLOW_PRIVATE_LLM_HOSTS=

# MCP stdio 会话绑定与能力级
#PRINTOPS_MCP_SESSION_ID=
#PRINTOPS_MCP_CAPABILITIES=L0
